# ── etimetracklite connection (choose SQL or API) ──────────────────────────
ETL_MODE=sql                          # "sql" or "api"

# SQL mode — ESSL / etimetracklite database
ETL_DB_DRIVER=mssql                   # "mysql" | "mssql"  (eSSL usually uses MSSQL)
ETL_DB_HOST=localhost                  # IP or hostname of SQL Server
ETL_DB_PORT=1433                       # 1433 for MSSQL, 3306 for MySQL
ETL_DB_NAME=etimetracklite             # your eSSL database name
ETL_DB_USER=sa                         # SQL login username
ETL_DB_PASSWORD=secret                 # SQL login password

# eSSL punch table names (defaults work for most installations)
# Change only if your eSSL uses custom table names
ESSL_PUNCH_TABLE=iclock_transaction    # or tbl_punchdata for older eSSL
ESSL_EMP_TABLE=hr_employee             # or tbl_employee
ESSL_EMP_ID_COL=emp_code
ESSL_EMP_NAME_COL=emp_name
ESSL_PUNCH_TIME_COL=punch_time
ESSL_PUNCH_STATE_COL=punch_state

# API mode
ETL_API_BASE_URL=https://your-etl-host/api
ETL_API_KEY=your_api_key_here

# ── Pingerbot WhatsApp API ──────────────────────────────────────────────────
# Your Pingerbot credentials from api1.pingerbot.in
PINGERBOT_INSTANCE_ID=7EA99421CD2E
PINGERBOT_API_TOKEN=gLm6QqsuqC

# ── Scheduler ───────────────────────────────────────────────────────────────
# Time to send daily roster notification (24h format, server local time)
SEND_TIME=07:00
# 0 = today's roster, 1 = tomorrow's roster
SEND_DAY_OFFSET=0

# ── Report ───────────────────────────────────────────────────────────────────
# Who receives the summary report (manager phone numbers, comma-separated, with country code)
MANAGER_PHONES=+919999999999,+919888888888

# ── Web App ─────────────────────────────────────────────────────────────────
WEB_SECRET_KEY=change-this-to-a-random-secret
WEB_PORT=5000
# Admin credentials for the web dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# Comma-separated phones allowed to send roster via WhatsApp (leave blank = allow all)
AUTHORIZED_SENDERS=+919999999999,+919888888888

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/shift_roster.log
