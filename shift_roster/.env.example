# ── etimetracklite connection (choose SQL or API) ──────────────────────────
ETL_MODE=sql                          # "sql" or "api"

# SQL mode (MySQL or MSSQL)
ETL_DB_DRIVER=mysql                   # "mysql" | "mssql"
ETL_DB_HOST=localhost
ETL_DB_PORT=3306
ETL_DB_NAME=etimetracklite
ETL_DB_USER=root
ETL_DB_PASSWORD=secret

# API mode
ETL_API_BASE_URL=https://your-etl-host/api
ETL_API_KEY=your_api_key_here

# ── Pingerbot WhatsApp API ──────────────────────────────────────────────────
PINGERBOT_API_URL=https://your-pingerbot-host/api/send
PINGERBOT_API_TOKEN=your_pingerbot_token_here
# Optional: instance/session ID if your pingerbot uses multi-session
PINGERBOT_INSTANCE_ID=

# ── Scheduler ───────────────────────────────────────────────────────────────
# Time to send daily roster notification (24h format, server local time)
SEND_TIME=07:00
# 0 = today's roster, 1 = tomorrow's roster
SEND_DAY_OFFSET=0

# ── Report ───────────────────────────────────────────────────────────────────
# Who receives the summary report (manager phone numbers, comma-separated, with country code)
MANAGER_PHONES=+919999999999,+919888888888

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/shift_roster.log
